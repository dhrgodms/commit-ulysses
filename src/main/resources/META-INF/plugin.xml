<idea-plugin>
    <id>com.ok.commitulysses</id>
    <name>Commit Ulysses</name>
    <vendor>Ok Haeeun</vendor>
    <description>커밋 전 체크리스트를 강제하는 플러그인</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.ok.commitulysses.ChecklistSettingsService"/>

        <projectConfigurable
                parentId="tools"
                instance="com.ok.commitulysses.ChecklistConfigurable"
                id="com.ok.commitulysses.settings"
                displayName="Commit Ulysses"/>

        <checkinHandlerFactory implementation="com.ok.commitulysses.ChecklistCheckinHandlerFactory"/>

        <toolWindow id="Commit Ulysses"
                    anchor="right"
                    icon="/icons/toolWindow.svg"
                    factoryClass="com.ok.commitulysses.ChecklistToolWindowFactory"/>
    </extensions>
</idea-plugin>
